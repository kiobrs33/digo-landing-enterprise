# API de digo-landing-backend.
# - CONTENT_API_URL: de dónde se descarga el contenido al hacer build (y el proxy de `npm run dev`).
# - VITE_API_URL: a dónde envían los formularios desde el navegador. Vacía en local (usa el proxy).
CONTENT_API_URL=http://localhost:4110
VITE_API_URL=

# Dirección de este sitio (canónicas, sitemap y vistas previas) y del sitio de hogar
VITE_SITE_URL=https://digoempresas.pe
VITE_HOGAR_URL=https://www.digo.net.pe
